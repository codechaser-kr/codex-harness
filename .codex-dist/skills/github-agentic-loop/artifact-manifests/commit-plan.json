{
  "artifact_type": "commit-plan",
  "manifest_version": 1,
  "producer_skill": "commit-plan",
  "contract_section": "커밋 계획(`commit-plan`) 출력 판정 규칙",
  "fields": [
    { "field_id": "base_issue", "required": true, "render_label": "기준 이슈", "shape": { "type": "string", "min_length": 1 } },
    {
      "field_id": "current_pr_unit",
      "required": true,
      "render_label": "현재 브랜치/PR 단위",
      "shape": {
        "type": "object",
        "additional_properties": false,
        "fields": [
          { "field_id": "unit_id", "required": true, "render_label": "단위 ID", "shape": { "type": "string", "min_length": 1 } },
          { "field_id": "work_content", "required": true, "render_label": "작업 내용", "shape": { "type": "string", "min_length": 1 } },
          { "field_id": "prerequisites", "required": true, "render_label": "선행 조건", "shape": { "type": "array", "items": { "type": "string", "min_length": 1 } } },
          { "field_id": "pr_validation_criteria", "required": true, "render_label": "PR 단위 검증 기준", "shape": { "type": "array", "min_items": 1, "items": { "type": "string", "min_length": 1 } } }
        ]
      }
    },
    { "field_id": "current_branch", "required": true, "render_label": "현재 작업 브랜치", "shape": { "type": "string", "min_length": 1 } },
    { "field_id": "plan_basis", "required": true, "render_label": "계획 근거", "shape": { "type": "string", "min_length": 1 } },
    {
      "field_id": "commit_units",
      "required": true,
      "render_label": "커밋 단위",
      "shape": {
        "type": "array",
        "min_items": 1,
        "items": {
          "type": "object",
          "additional_properties": false,
          "fields": [
            { "field_id": "unit_id", "required": true, "render_label": "단위 ID", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "work_scope", "required": true, "render_label": "작업 범위", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "modification_targets", "required": true, "render_label": "수정 대상", "shape": { "type": "array", "min_items": 1, "items": { "type": "string", "min_length": 1 } } },
            { "field_id": "validation_criteria", "required": true, "render_label": "검증 기준", "shape": { "type": "array", "min_items": 1, "items": { "type": "string", "min_length": 1 } } }
          ]
        }
      }
    },
    { "field_id": "implementation_order", "required": true, "render_label": "구현 순서", "shape": { "type": "array", "min_items": 1, "items": { "type": "string", "min_length": 1 } } },
    { "field_id": "blocking_questions", "required": true, "render_label": "보류 질문", "shape": { "type": "array", "items": { "type": "string", "min_length": 1 } } }
  ],
  "rules": [
    { "rule_id": "commit-unit-id-unique", "rule_type": "unique_by", "source_path": "/commit_units", "target_path": "/unit_id" },
    { "rule_id": "implementation-order-complete", "rule_type": "covers_exactly", "source_path": "/implementation_order", "target_path": "/commit_units/*/unit_id" }
  ],
  "render": { "section_order": ["base_issue", "current_pr_unit", "current_branch", "plan_basis", "commit_units", "implementation_order", "blocking_questions"] }
}
