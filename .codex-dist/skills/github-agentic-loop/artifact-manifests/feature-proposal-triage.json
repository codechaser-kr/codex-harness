{
  "artifact_type": "feature-proposal-triage",
  "manifest_version": 1,
  "producer_skill": "feature-proposal-triage",
  "contract_section": "기능 제안 분류(`feature-proposal-triage`) 출력 판정 규칙",
  "fields": [
    { "field_id": "base_issue", "required": true, "render_label": "기준 이슈", "shape": { "type": "string", "min_length": 1 } },
    { "field_id": "decision_context", "required": true, "render_label": "판단 맥락", "shape": { "type": "string", "min_length": 1 } },
    {
      "field_id": "direction_candidates",
      "required": true,
      "render_label": "진행 방향 후보",
      "shape": {
        "type": "array",
        "min_items": 3,
        "items": {
          "type": "object",
          "additional_properties": false,
          "fields": [
            { "field_id": "direction", "required": true, "render_label": "진행 방향", "shape": { "type": "string", "enum_values": ["진행하지 않음", "정책 검토 필요", "기능 변경 필요"] } },
            { "field_id": "rationale_and_risk", "required": true, "render_label": "판단 근거와 위험", "shape": { "type": "string", "min_length": 1 } }
          ]
        }
      }
    },
    { "field_id": "recommended_direction", "required": true, "render_label": "추천 방향", "shape": { "type": "string", "enum_values": ["", "진행하지 않음", "정책 검토 필요", "기능 변경 필요"] } },
    { "field_id": "blocking_questions", "required": true, "render_label": "보류 질문", "shape": { "type": "array", "items": { "type": "string", "min_length": 1 } } }
  ],
  "rules": [
    { "rule_id": "direction-candidate-unique", "rule_type": "unique_by", "source_path": "/direction_candidates", "target_path": "/direction" },
    { "rule_id": "recommended-direction-reference", "rule_type": "references", "source_path": "/recommended_direction", "target_path": "/direction_candidates/*/direction", "allow_empty": true }
  ],
  "render": { "section_order": ["base_issue", "decision_context", "direction_candidates", "recommended_direction", "blocking_questions"] }
}
