{
  "artifact_type": "policy-review-next-triage",
  "manifest_version": 1,
  "producer_skill": "policy-review-next-triage",
  "contract_section": "정책 검토 후속 분류(`policy-review-next-triage`) 출력 판정 규칙",
  "fields": [
    { "field_id": "base_policy_issue", "required": true, "render_label": "기준 정책검토 이슈", "shape": { "type": "string", "min_length": 1 } },
    { "field_id": "feature_change_scope", "required": true, "render_label": "기능변경 전환 범위", "shape": { "type": "string", "min_length": 1 } },
    { "field_id": "search_results", "required": true, "render_label": "탐색 결과", "shape": { "type": "string", "min_length": 1 } },
    {
      "field_id": "transition_candidates",
      "required": true,
      "render_label": "전환 후보",
      "shape": {
        "type": "array",
        "min_items": 1,
        "items": {
          "type": "object",
          "additional_properties": false,
          "fields": [
            { "field_id": "candidate_id", "required": true, "render_label": "후보 ID", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "direction", "required": true, "render_label": "진행 방향", "shape": { "type": "string", "enum_values": ["기존 기능변경 이슈 반영", "새 기능변경 이슈 생성"] } },
            { "field_id": "target_issue", "required": true, "render_label": "대상 이슈", "shape": { "type": "string" } },
            { "field_id": "application_scope", "required": true, "render_label": "반영 범위", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "rationale_and_risk", "required": true, "render_label": "판단 근거와 위험", "shape": { "type": "string", "min_length": 1 } }
          ]
        }
      }
    },
    { "field_id": "recommended_candidate", "required": true, "render_label": "추천 후보", "shape": { "type": "string" } },
    { "field_id": "blocking_questions", "required": true, "render_label": "보류 질문", "shape": { "type": "array", "items": { "type": "string", "min_length": 1 } } }
  ],
  "rules": [
    { "rule_id": "transition-candidate-id-unique", "rule_type": "unique_by", "source_path": "/transition_candidates", "target_path": "/candidate_id" },
    { "rule_id": "recommended-candidate-reference", "rule_type": "references", "source_path": "/recommended_candidate", "target_path": "/transition_candidates/*/candidate_id", "allow_empty": true }
  ],
  "render": { "section_order": ["base_policy_issue", "feature_change_scope", "search_results", "transition_candidates", "recommended_candidate", "blocking_questions"] }
}
