{
  "artifact_type": "review-comment",
  "manifest_version": 1,
  "producer_skill": "review-comment",
  "contract_section": "리뷰 코멘트 출력 판정 규칙 (`review-comment`)",
  "fields": [
    { "field_id": "pr_number", "required": true, "render_label": "pr_number", "shape": { "type": "integer", "minimum": 1 } },
    {
      "field_id": "inline_review_threads",
      "required": true,
      "render_label": "inline_review_threads",
      "shape": {
        "type": "array",
        "items": {
          "type": "object",
          "additional_properties": false,
          "fields": [
            { "field_id": "severity", "required": true, "render_label": "중요도", "shape": { "type": "string", "enum_values": ["[차단]", "[중요]", "[사소]", "[제안]", "[학습]", "[칭찬]"] } },
            { "field_id": "file", "required": true, "render_label": "파일 경로", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "line", "required": true, "render_label": "diff line", "shape": { "type": "integer", "minimum": 1 } },
            { "field_id": "diff_position", "required": true, "render_label": "GitHub diff position", "shape": { "type": "integer", "minimum": 1 } },
            { "field_id": "problem", "required": true, "render_label": "문제", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "impact", "required": true, "render_label": "영향", "shape": { "type": "string", "min_length": 1 } },
            { "field_id": "recommended_action", "required": true, "render_label": "권장 조치", "shape": { "type": "string", "min_length": 1 } }
          ]
        }
      }
    },
    { "field_id": "questions", "required": true, "render_label": "questions", "shape": { "type": "array", "items": { "type": "string", "min_length": 1 } } }
  ],
  "rules": [],
  "render": { "section_order": ["pr_number", "inline_review_threads", "questions"] }
}
