{
  "base_definition": {
    "workflow_id": "implementation",
    "entry_task_action_id": "FI-1",
    "facts": { "flag": [true, false] },
    "transitions": [
      {
        "task_action_id": "FI-1",
        "normalized_fact_conditions": { "fact_id": "flag", "operator": "exists" },
        "user_decision_options": [],
        "completion_predicate": { "fact_id": "flag", "operator": "exists" },
        "executor_reference": null,
        "next_transition_rules": [{ "condition": null, "task_action_id": "FI-2" }]
      },
      {
        "task_action_id": "FI-2",
        "normalized_fact_conditions": { "fact_id": "flag", "operator": "exists" },
        "user_decision_options": [],
        "completion_predicate": { "fact_id": "flag", "operator": "exists" },
        "executor_reference": null,
        "next_transition_rules": []
      }
    ]
  },
  "cases": [
    {
      "name": "duplicate task action ID",
      "mutations": [{ "op": "set", "path": ["transitions", 1, "task_action_id"], "value": "FI-1" }],
      "expected_code": "task_action_id.duplicate"
    },
    {
      "name": "unknown entry and rule references",
      "mutations": [
        { "op": "set", "path": ["entry_task_action_id"], "value": "FI-9" },
        { "op": "set", "path": ["transitions", 0, "next_transition_rules", 0, "task_action_id"], "value": "FI-8" }
      ],
      "expected_code": "entry_task_action_id.unknown"
    },
    {
      "name": "unreachable transition",
      "mutations": [{
        "op": "append",
        "path": ["transitions"],
        "value": {
          "task_action_id": "FI-3",
          "normalized_fact_conditions": { "fact_id": "flag", "operator": "exists" },
          "user_decision_options": [],
          "completion_predicate": { "fact_id": "flag", "operator": "exists" },
          "executor_reference": null,
          "next_transition_rules": [{ "condition": null, "task_action_id": "FI-2" }]
        }
      }],
      "expected_code": "transition.unreachable"
    },
    {
      "name": "cycle without terminal path",
      "mutations": [{ "op": "set", "path": ["transitions", 0, "next_transition_rules", 0, "task_action_id"], "value": "FI-1" }],
      "expected_code": "transition.cycle_without_terminal"
    },
    {
      "name": "cycle terminal rule is not a satisfiable escape",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [
          { "condition": { "fact_id": "flag", "operator": "in", "value": [true, false] }, "task_action_id": "FI-1" },
          { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": true }, { "fact_id": "flag", "operator": "equals", "value": false }] }, "task_action_id": "FI-2" }
        ]
      }],
      "expected_code": "transition.cycle_without_terminal"
    },
    {
      "name": "conditional overlap",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [
          { "condition": { "fact_id": "flag", "operator": "equals", "value": true }, "task_action_id": "FI-2" },
          { "condition": { "fact_id": "flag", "operator": "equals", "value": true }, "task_action_id": "FI-2" }
        ]
      }],
      "expected_code": "next_transition_rules.condition_overlap"
    },
    {
      "name": "rule condition validates fact references",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [{ "condition": { "fact_id": "missing", "operator": "equals", "value": true }, "task_action_id": "FI-2" }]
      }],
      "expected_code": "expression.fact.unknown"
    },
    {
      "name": "conditional gap",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [{ "condition": { "fact_id": "flag", "operator": "equals", "value": true }, "task_action_id": "FI-2" }]
      }],
      "expected_code": "next_transition_rules.condition_gap"
    },
    {
      "name": "unsatisfiable completion predicate",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 1, "completion_predicate"],
        "value": { "all": [{ "fact_id": "flag", "operator": "equals", "value": true }, { "fact_id": "flag", "operator": "equals", "value": false }] }
      }],
      "expected_code": "completion_predicate.unsatisfiable"
    },
    {
      "name": "completion predicate state space limit includes missing state",
      "options": { "maxConditionStates": 2 },
      "mutations": [],
      "expected_code": "completion_predicate_state_space.limit_exceeded"
    },
    {
      "name": "coverage collects a late satisfiable rule after witnesses",
      "mutations": [
        { "op": "set", "path": ["facts", "phase"], "value": [true, false] },
        {
          "op": "set",
          "path": ["transitions", 0, "next_transition_rules"],
          "value": [
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": true }, { "fact_id": "phase", "operator": "equals", "value": false }] }, "task_action_id": "FI-2" },
            { "condition": { "fact_id": "phase", "operator": "equals", "value": false }, "task_action_id": "FI-2" },
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": false }, { "fact_id": "phase", "operator": "equals", "value": true }] }, "task_action_id": "FI-3" }
          ]
        },
        {
          "op": "append",
          "path": ["transitions"],
          "value": {
            "task_action_id": "FI-3",
            "normalized_fact_conditions": { "fact_id": "flag", "operator": "exists" },
            "user_decision_options": [],
            "completion_predicate": { "fact_id": "flag", "operator": "exists" },
            "executor_reference": null,
            "next_transition_rules": [{ "condition": null, "task_action_id": "FI-2" }]
          }
        }
      ],
      "expected_code": "next_transition_rules.condition_gap",
      "absent_codes": ["transition.unreachable", "transition.no_terminal_path"]
    },
    {
      "name": "unconditional rule mixed with conditional rule",
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [
          { "condition": null, "task_action_id": "FI-2" },
          { "condition": { "fact_id": "flag", "operator": "equals", "value": true }, "task_action_id": "FI-2" }
        ]
      }],
      "expected_code": "next_transition_rules.unconditional_mixed"
    },
    {
      "name": "condition state space limit",
      "options": { "maxConditionStates": 1 },
      "mutations": [{
        "op": "set",
        "path": ["transitions", 0, "next_transition_rules"],
        "value": [
          { "condition": { "fact_id": "flag", "operator": "equals", "value": true }, "task_action_id": "FI-2" },
          { "condition": { "fact_id": "flag", "operator": "equals", "value": false }, "task_action_id": "FI-2" }
        ]
      }],
      "expected_code": "condition_state_space.limit_exceeded"
    },
    {
      "name": "relevant condition state space limit",
      "options": { "maxConditionStates": 3 },
      "mutations": [
        { "op": "set", "path": ["facts", "phase"], "value": [true, false] },
        {
          "op": "set",
          "path": ["transitions", 0, "next_transition_rules"],
          "value": [
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": true }, { "fact_id": "phase", "operator": "equals", "value": true }] }, "task_action_id": "FI-2" },
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": true }, { "fact_id": "phase", "operator": "equals", "value": false }] }, "task_action_id": "FI-2" },
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": false }, { "fact_id": "phase", "operator": "equals", "value": true }] }, "task_action_id": "FI-2" },
            { "condition": { "all": [{ "fact_id": "flag", "operator": "equals", "value": false }, { "fact_id": "phase", "operator": "equals", "value": false }] }, "task_action_id": "FI-2" }
          ]
        }
      ],
      "expected_code": "condition_state_space.limit_exceeded",
      "expected_path": "/transitions/0/next_transition_rules"
    }
  ]
}
