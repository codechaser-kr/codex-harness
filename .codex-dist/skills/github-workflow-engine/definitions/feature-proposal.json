    { "fact_id": "feature_proposal_draft_confirmed", "value_type": "boolean", "allowed_values": [true, false], "evidence_required": true },
    { "fact_id": "feature_proposal_issue_created", "value_type": "boolean", "allowed_values": [true, false], "evidence_required": true },
