{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-harness.local/schemas/workflow-definition.schema.json",
  "title": "Workflow Definition",
  "type": "object",
  "required": [
    "workflow_id",
    "version",
    "workflow_kind",
    "target_type",
    "entry_transition_id",
    "terminal_transition_ids",
    "normalized_fact_schema",
    "transitions"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "workflow_kind": {
      "type": "string",
      "enum": [
        "feature_proposal",
        "policy_review",
        "feature_change",
        "feature_fix",
        "implementation"
      ]
    },
    "target_type": {
      "type": "string",
      "enum": [
        "issue",
        "pull_request",
        "repository"
      ]
    },
    "entry_transition_id": {
      "$ref": "#/$defs/stableId"
    },
    "terminal_transition_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "normalized_fact_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1
    },
    "factValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "value_type",
        "allowed_values",
        "evidence_required"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/stableId"
        },
        "value_type": {
          "type": "string",
          "enum": [
            "boolean",
            "string",
            "integer"
          ]
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1
        },
        "evidence_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "string"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "integer"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/leafExpression"
        },
        {
          "$ref": "#/$defs/allExpression"
        },
        {
          "$ref": "#/$defs/anyExpression"
        },
        {
          "$ref": "#/$defs/notExpression"
        }
      ]
    },
    "leafExpression": {
      "type": "object",
      "required": [
        "fact_id",
        "operator"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/stableId"
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "exists",
            "not_exists"
          ]
        },
        "value": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "equals",
                  "not_equals"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/$defs/factValue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/factValue"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "not_exists"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "allExpression": {
      "type": "object",
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "additionalProperties": false
    },
    "anyExpression": {
      "type": "object",
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "additionalProperties": false
    },
    "notExpression": {
      "type": "object",
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": false
    },
    "decisionOption": {
      "type": "object",
      "required": [
        "decision_id",
        "label"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "userDecisionSpecification": {
      "type": "object",
      "required": [
        "required",
        "options",
        "allow_free_form",
        "block_execution_until_confirmed"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionOption"
          }
        },
        "allow_free_form": {
          "type": "boolean"
        },
        "block_execution_until_confirmed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "nullableStableId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "nextTransitionRule": {
      "type": "object",
      "required": [
        "condition",
        "transition_id"
      ],
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "transition_id": {
          "$ref": "#/$defs/stableId"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "transition_id",
        "normalized_fact_conditions",
        "task_action_id",
        "user_decision_specification",
        "completion_predicate",
        "executor_reference",
        "next_transition_rules"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/stableId"
        },
        "normalized_fact_conditions": {
          "$ref": "#/$defs/expression"
        },
        "task_action_id": {
          "type": "string",
          "pattern": "^(FP|PR|FC|FF|FI)-[1-9][0-9]*$"
        },
        "user_decision_specification": {
          "$ref": "#/$defs/userDecisionSpecification"
        },
        "completion_predicate": {
          "$ref": "#/$defs/expression"
        },
        "executor_reference": {
          "$ref": "#/$defs/nullableStableId"
        },
        "next_transition_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nextTransitionRule"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
