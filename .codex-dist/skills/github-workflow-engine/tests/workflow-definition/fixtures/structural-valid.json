{
  "cases": [
    {
      "name": "valid workflow definition",
      "definition": {
        "workflow_id": "feature-change-flow",
        "version": "1.0.0",
        "workflow_kind": "feature_change",
        "target_type": "issue",
        "entry_transition_id": "collect-state",
        "terminal_transition_ids": [
          "complete"
        ],
        "normalized_fact_schema": [
          {
            "fact_id": "issue_open",
            "value_type": "boolean",
            "allowed_values": [
              true,
              false
            ],
            "evidence_required": true
          },
          {
            "fact_id": "review_state",
            "value_type": "string",
            "allowed_values": [
              "pending",
              "approved"
            ],
            "evidence_required": false
          },
          {
            "fact_id": "review_count",
            "value_type": "integer",
            "allowed_values": [
              0,
              1,
              2
            ],
            "evidence_required": false
          }
        ],
        "transitions": [
          {
            "transition_id": "collect-state",
            "normalized_fact_conditions": {
              "all": [
                {
                  "fact_id": "issue_open",
                  "operator": "equals",
                  "value": true
                },
                {
                  "not": {
                    "fact_id": "review_state",
                    "operator": "equals",
                    "value": "approved"
                  }
                }
              ]
            },
            "task_action_id": "C-1",
            "user_decision_specification": {
              "required": true,
              "options": [
                {
                  "decision_id": "continue",
                  "label": "Continue"
                }
              ],
              "allow_free_form": false,
              "block_execution_until_confirmed": true
            },
            "completion_predicate": {
              "fact_id": "review_count",
              "operator": "in",
              "value": [
                1,
                2
              ]
            },
            "registered_executor_reference": "github-state-summary",
            "next_transition": "complete"
          },
          {
            "transition_id": "complete",
            "normalized_fact_conditions": {
              "any": [
                {
                  "fact_id": "review_state",
                  "operator": "equals",
                  "value": "approved"
                }
              ]
            },
            "task_action_id": "C-2",
            "user_decision_specification": {
              "required": false,
              "options": [],
              "allow_free_form": true,
              "block_execution_until_confirmed": false
            },
            "completion_predicate": {
              "fact_id": "issue_open",
              "operator": "not_exists"
            },
            "registered_executor_reference": null,
            "next_transition": null
          }
        ]
      }
    }
  ]
}
